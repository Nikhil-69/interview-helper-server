# Server
PORT=4000

# MySQL (local: `docker compose up -d` starts a mysql:8 container)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=interview_helper
DB_PASSWORD=interview_helper_password
DB_NAME=interview_helper

# Root creds for `npm run migrate` (creates the DB/user/tables) — must match
# MYSQL_ROOT_PASSWORD used by docker-compose.yml
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=password

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OpenAI (server-side key — never shipped to clients)
OPENAI_API_KEY=sk-...

# Seed admin (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

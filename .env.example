# Server
PORT=4000

# MongoDB
# Local:  `docker compose up -d` starts a mongo:7 container
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview_helper
MONGODB_URI=mongodb://127.0.0.1:27017/interview_helper
# Per-instance connection pool size. Defaults: 10 locally, 5 on Vercel (serverless).
# DB_POOL_SIZE=5

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OpenAI (server-side key — never shipped to clients)
# OPENAI_BASE_URL lets this point at an OpenAI-compatible proxy instead of api.openai.com
# OPENAI_MODEL / OPENAI_MAX_TOKENS override the ai_model / ai_max_tokens admin settings when set
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://cliproxyapi.aniex.site/v1
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_MAX_TOKENS=1000

# Vertex AI (Gemini) fallback — used automatically if the OpenAI-compatible
# provider above fails or isn't configured.
# Local dev: point VERTEX_KEY_FILE at a service-account JSON on disk.
# Vercel/serverless: set VERTEX_SERVICE_ACCOUNT_JSON instead (raw or base64 JSON
# contents) since there's no writable filesystem to place a key file on.
VERTEX_PROJECT_ID=naukri-iimjobs-recruiter
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-pro
VERTEX_KEY_FILE=./credentials/vertex-service-account.json
# VERTEX_SERVICE_ACCOUNT_JSON=

# Razorpay (payments). Leave all three unset to use the mock gateway in dev.
# Key id/secret come from Dashboard → Settings → API Keys (test mode keys start rzp_test_).
# Webhook secret is whatever you set when creating the webhook in Dashboard → Webhooks.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# Seed admin (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
